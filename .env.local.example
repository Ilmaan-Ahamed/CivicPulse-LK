# Local MinIO values for docker-compose.yml. Do not reuse these in production.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=civicpulse-reports
# Set these when the server and browser reach MinIO at different hostnames.
# Compose uses MINIO_ENDPOINT=minio internally and MINIO_PUBLIC_ENDPOINT=localhost for browser URLs.
# MINIO_PUBLIC_ENDPOINT=localhost
# MINIO_PUBLIC_PORT=9000
# MINIO_PUBLIC_USE_SSL=false