// ===========================================
// CivicPulse LK - Database Schema
// ===========================================
// PostgreSQL + PostGIS via Neon DB
// Run: npx prisma db push

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ===========================================
// Enums
// ===========================================

enum Role {
  CITIZEN
  NGO_PARTNER
  DS_OFFICER
  ADMIN
}

enum Language {
  EN
  SI
  TA
}

enum Category {
  ROAD_DAMAGE
  DRAINAGE
  STREETLIGHT
  WATER_SUPPLY
  WASTE
  BRIDGE
  PUBLIC_BUILDING
  SIDEWALK
  TRAFFIC_SIGNAL
  OTHER
}

enum ReportStatus {
  SUBMITTED
  UNDER_VERIFICATION
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  FIELD_VERIFIED
  RESOLVED
  REJECTED
  CLOSED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum VerificationStatus {
  CONFIRMED
  DISPUTED
  NEEDS_INFO
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
  ASSIGNED
  REJECTED
}

enum AgencyType {
  AGENCY
  NGO
  FIELD_TEAM
}

enum InspectionResult {
  CONFIRMED_RESOLVED
  PARTIALLY_RESOLVED
  NOT_RESOLVED
  ESCALATE
}

// ===========================================
// Models
// ===========================================

model User {
  id                 String   @id @default(cuid())
  clerkId            String   @unique
  email              String   @unique
  firstName          String?
  lastName           String?
  avatarUrl          String?
  role               Role     @default(CITIZEN)
  trustScore         Float    @default(50)
  preferredLang      Language @default(EN)
  district           String? // legacy — kept for existing data
  dsDivision         String? // DS Division / district picker from onboarding
  phone              String? // optional phone number
  onboardingComplete Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  reports              Report[]          @relation("ReportAuthor")
  verifications        Verification[]    @relation("VerificationAuthor")
  assignments          Assignment[]      @relation("AssignedByOfficer")
  fieldTasks           Assignment[]      @relation("AssignedToAgent")
  inspections          FieldInspection[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  roleRequests         RoleRequest[]     @relation("UserRoleRequests")
  reviewedRoleRequests RoleRequest[]     @relation("ReviewedRequests")

  @@index([clerkId])
  @@index([role])
  @@index([district])
  @@index([onboardingComplete])
}

model Report {
  id            String       @id @default(cuid())
  referenceNo   String       @unique @default(cuid())
  citizenId     String
  category      Category
  title         String
  description   String
  summary       String? // AI-generated summary
  latitude      Float
  longitude     Float
  address       String?
  district      String?
  status        ReportStatus @default(SUBMITTED)
  priority      Priority? // AI-suggested priority
  aiConfidence  Float? // AI confidence score (0-1)
  duplicateOfId String? // If flagged as duplicate
  isDuplicate   Boolean      @default(false)
  verifyCount   Int          @default(0)
  disputeCount  Int          @default(0)
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  citizen       User            @relation("ReportAuthor", fields: [citizenId], references: [id])
  duplicateOf   Report?         @relation("DuplicateReports", fields: [duplicateOfId], references: [id])
  duplicates    Report[]        @relation("DuplicateReports")
  photos        Photo[]
  verifications Verification[]
  assignments   Assignment[]
  statusHistory StatusHistory[]

  @@index([citizenId])
  @@index([status])
  @@index([category])
  @@index([district])
  @@index([createdAt])
  @@index([latitude, longitude])
}

model Photo {
  id             String   @id @default(cuid())
  url            String
  key            String // MinIO object key
  caption        String?
  reportId       String?
  verificationId String?
  inspectionId   String?
  createdAt      DateTime @default(now())

  // Relations
  report       Report?          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  verification Verification?    @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  inspection   FieldInspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([verificationId])
  @@index([inspectionId])
}

model Verification {
  id         String             @id @default(cuid())
  reportId   String
  verifierId String
  status     VerificationStatus
  comment    String?
  latitude   Float? // Verifier's location for proximity proof
  longitude  Float?
  createdAt  DateTime           @default(now())

  // Relations
  report   Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  verifier User    @relation("VerificationAuthor", fields: [verifierId], references: [id])
  photos   Photo[]

  @@unique([reportId, verifierId]) // One verification per user per report
  @@index([reportId])
  @@index([verifierId])
}

model Assignment {
  id           String           @id @default(cuid())
  reportId     String
  dsOfficerId  String? // DS Officer who made the assignment (legacy field)
  assignedToId String? // Agency/NGO/Volunteer assigned to (legacy field)
  agencyId     String? // Agency/NGO/Field Team assigned to (new field)
  assignedById String? // DS Officer who made the assignment (new field)
  status       AssignmentStatus @default(PENDING)
  notes        String?
  deadline     DateTime?
  acceptedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  report      Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  agency      Agency?           @relation(fields: [agencyId], references: [id])
  assignedBy  User?             @relation("AssignedByOfficer", fields: [assignedById], references: [id])
  assignedTo  User?             @relation("AssignedToAgent", fields: [assignedToId], references: [id])
  inspections FieldInspection[]

  @@index([reportId])
  @@index([dsOfficerId])
  @@index([assignedToId])
  @@index([agencyId])
  @@index([assignedById])
  @@index([status])
}

model FieldInspection {
  id           String           @id @default(cuid())
  assignmentId String
  inspectorId  String
  findings     String
  result       InspectionResult
  latitude     Float // GPS proof of presence
  longitude    Float
  inspectedAt  DateTime         @default(now())
  createdAt    DateTime         @default(now())

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  inspector  User       @relation(fields: [inspectorId], references: [id])
  photos     Photo[]

  @@index([assignmentId])
  @@index([inspectorId])
}

model StatusHistory {
  id         String        @id @default(cuid())
  reportId   String
  fromStatus ReportStatus?
  toStatus   ReportStatus
  changedBy  String? // User ID who caused the change
  reason     String?
  createdAt  DateTime      @default(now())

  // Relations
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([createdAt])
}

model Agency {
  id           String   @id @default(cuid())
  name         String
  type         String // GOVERNMENT, NGO, VOLUNTEER_TEAM, CSR (kept as String for backward compatibility)
  contactEmail String?
  contactPhone String?
  district     String?
  description  String? // Kept for backward compatibility
  isActive     Boolean  @default(true) // Kept for backward compatibility
  contactName  String? // New field
  active       Boolean  @default(true) // New field (will use this going forward)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  assignments Assignment[]

  @@index([type])
  @@index([district])
  @@index([isActive])
  @@index([active])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String // REPORT_UPDATE, VERIFICATION, ASSIGNMENT, etc.
  entityId  String? // Related report/assignment ID
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // Nullable for backward compatibility
  action    String // ASSIGNMENT_CREATED, ASSIGNMENT_STATUS_UPDATED, AGENCY_CREATED, etc.
  entity    String? // Legacy field name (nullable for backward compatibility)
  entityId  String? // Legacy field name (nullable for backward compatibility)
  targetType String? // Report, Assignment, Agency, etc. (nullable for backward compatibility)
  targetId  String? // Nullable for backward compatibility
  metadata  Json? // Additional context (before/after values, etc.)
  ipAddress String?
  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ===========================================
// Role Request (Onboarding — pending approval)
// ===========================================

model RoleRequest {
  id            String            @id @default(cuid())
  userId        String
  requestedRole Role // NGO | AGENCY | DS_OFFICER
  orgName       String? // For NGO / Agency
  justification String? // Why do you need this role?
  dsDivision    String? // Relevant division/district context
  status        RoleRequestStatus @default(PENDING)
  reviewedBy    String? // Admin userId who approved/rejected
  reviewedAt    DateTime?
  reviewNote    String? // Admin note (for NEEDS_INFO or REJECTED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  user     User  @relation("UserRoleRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewedRequests", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestedRole])
  @@index([createdAt])
}
